---
interface Props {
  title: string;
  link: string;
  stack: string;
  description: string;
  image?: any;
  index?: number;
}

const { title, link, stack, description, image, index = 0 } = Astro.props;
const tags = stack.split(",").map((t: string) => t.trim()).filter(Boolean);
const delay = `${0.05 + index * 0.08}s`;
---

<a
  href={link}
  target="_blank"
  rel="noopener noreferrer"
  class="block group focus:outline-none focus-visible:ring-2 focus-visible:ring-white h-full"
  aria-label={`Open ${title} project in a new tab`}
>
  <article
    class="hud-corners fade-in-card relative h-full bg-black border-2 sm:border-[3px] border-white/30 p-5 sm:p-6 shadow-2xl flex flex-col transition-all duration-300 group-hover:border-accent/60 group-hover:-translate-y-1 group-hover:shadow-accent/20 overflow-hidden"
    style={`animation-delay: ${delay};`}
  >
    <span class="hud-scanline"></span>

    <div class="flex items-start justify-between gap-3 mb-4">
      {image ? (
        <div class="shrink-0 w-12 h-12 sm:w-14 sm:h-14 bg-white/5 border-2 border-white/20 flex items-center justify-center transition-all duration-300 group-hover:border-accent/60 group-hover:scale-105">
          <img
            src={image}
            alt={`Logo for ${title}`}
            class="w-9 h-9 sm:w-10 sm:h-10 object-contain"
            loading="lazy"
          />
        </div>
      ) : (
        <div class="shrink-0 w-12 h-12 sm:w-14 sm:h-14 bg-white/5 border-2 border-white/20"></div>
      )}
      <span
        class="shrink-0 text-white/40 text-xl group-hover:text-accent group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all duration-300"
        aria-hidden="true"
      >
        ↗
      </span>
    </div>

    <h3 class="font-display text-base sm:text-lg font-bold text-white uppercase tracking-wide leading-tight mb-2 group-hover:text-white">
      {title}
    </h3>

    <p class="text-sm text-gray-400 leading-relaxed mb-4 grow line-clamp-3 group-hover:text-gray-300 transition-colors">
      {description}
    </p>

    <div class="flex flex-wrap gap-1.5 pt-3 border-t border-white/10">
      {tags.map((tag: string) => (
        <span class="text-[10px] sm:text-xs font-mono text-gray-400 bg-white/5 border border-white/15 px-2 py-1 uppercase tracking-wider group-hover:border-accent/30 group-hover:text-gray-300 transition-colors">
          {tag}
        </span>
      ))}
    </div>
  </article>
</a>

<style>
  @keyframes fadeInUp {
    0% {
      opacity: 0;
      transform: translateY(24px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .fade-in-card {
    opacity: 0;
    animation: fadeInUp 0.7s cubic-bezier(0.39, 0.575, 0.565, 1) both;
  }
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>