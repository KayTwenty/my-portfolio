---
import Link from "./Link.astro";
---

<footer class="text-sm sm:text-base w-full flex justify-start">
  <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-4 border-t-2 border-white/30 pt-4 sm:pt-5 font-mono">
    <div class="flex items-center gap-2 text-gray-500 uppercase tracking-wider text-xs">
      <svg class="w-3.5 h-3.5 text-accent-dim" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z"/>
      </svg>
      Built with
    </div>
    <div class="flex items-center gap-2 text-gray-400 flex-wrap uppercase tracking-wider font-bold text-xs">
      <Link href="https://astro.build/" title="AstroJS" />
      <span class="text-accent-dim">•</span>
      <Link href="https://reactjs.org/" title="ReactJS" />
      <span class="text-accent-dim">•</span>
      <Link href="https://tailwindcss.com" title="Tailwind" />
    </div>
    <p class="text-xs text-gray-600 uppercase tracking-widest">© {new Date().getFullYear()} Anton. All rights reserved.</p>
  </div>
</footer>