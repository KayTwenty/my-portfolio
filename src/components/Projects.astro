---
import { projects } from "../data/projects";
import Card from "./Card.astro";
---

<section id="projects" class="snap-start min-h-dvh w-full relative flex flex-col justify-center px-6 sm:px-12 lg:px-20 xl:px-28 py-24">
  <span class="section-index" aria-hidden="true" data-parallax="0.45">03</span>

  <div class="relative z-10 max-w-6xl">
    <p class="font-mono text-accent-dim text-xs sm:text-sm tracking-[0.3em] uppercase mb-4" data-reveal data-reveal-delay="0">// 03</p>
    <h2 class="glitch-text font-display text-3xl sm:text-4xl md:text-5xl font-bold text-white uppercase tracking-widest border-b-4 border-white/30 pb-2 sm:pb-3" data-text="Projects" data-reveal data-reveal-delay="80">Projects</h2>
    <p class="mt-5 sm:mt-7 text-lg sm:text-xl text-gray-300" data-reveal data-reveal-delay="160">
      I've built many projects using different technologies. Here are some of my
      notable works.
    </p>
    <div class="mt-9 mb-7 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5" data-reveal data-reveal-delay="240">
      {
        projects.map((project, index) => (
          <Card
            image={project.image}
            title={project.title}
            link={project.link}
            stack={project.stack}
            description={project.description}
            index={index}
          />
        ))
      }
    </div>
    <a
      href="https://github.com/KayTwenty?tab=repositories"
      class="group inline-flex items-center gap-2 text-lg sm:text-xl text-gray-300 font-bold hover:text-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent uppercase tracking-wider min-h-11 py-2 font-mono"
    >
      <span class="border-b-2 border-white/30 group-hover:border-accent transition-colors">View more projects</span>
      <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
    </a>
  </div>
</section>