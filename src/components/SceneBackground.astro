---
---

<canvas
  id="scene-background"
  class="pointer-events-none fixed inset-0 w-full h-full z-0"
  aria-hidden="true"
></canvas>

<script>
  import * as THREE from "three";

  const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const canvas = document.getElementById("scene-background") as HTMLCanvasElement | null;

  if (canvas && !prefersReduced) {
    const accent = new THREE.Color("#d7ff3a");

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(50, window.innerWidth / window.innerHeight, 0.1, 100);
    camera.position.set(0, 0, 8);

    const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
    renderer.setClearColor(0x000000, 0);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(window.innerWidth, window.innerHeight, false);

    // Declared early: marker/connection helpers below timestamp themselves with this.
    const clock = new THREE.Clock();

    // The whole assembly (core + shell + debris) lives in one group so it can
    // be shifted into the empty right-hand side of the asymmetric layout and
    // nudged toward the cursor as a single unit.
    const rig = new THREE.Group();
    scene.add(rig);

    // Outer wireframe shell -- crisp edge lines, not the messy default wireframe
    const shellGeometry = new THREE.IcosahedronGeometry(1.9, 1);
    const shellEdges = new THREE.EdgesGeometry(shellGeometry);
    const shell = new THREE.LineSegments(
      shellEdges,
      new THREE.LineBasicMaterial({ color: accent, transparent: true, opacity: 0.35 })
    );
    rig.add(shell);

    // Inner solid core, glowing faintly, rotating against the shell
    const core = new THREE.Mesh(
      new THREE.IcosahedronGeometry(0.95, 0),
      new THREE.MeshBasicMaterial({ color: accent, transparent: true, opacity: 0.08, wireframe: false })
    );
    rig.add(core);
    const coreEdges = new THREE.LineSegments(
      new THREE.EdgesGeometry(core.geometry),
      new THREE.LineBasicMaterial({ color: 0xffffff, transparent: true, opacity: 0.5 })
    );
    core.add(coreEdges);

    // --- "You are here" geolocation marker, pinned to the shell's surface ---
    function makeGlowSprite(color: string, size: number, opacity: number) {
      const canvas = document.createElement("canvas");
      canvas.width = canvas.height = 128;
      const ctx = canvas.getContext("2d")!;
      const gradient = ctx.createRadialGradient(64, 64, 0, 64, 64, 64);
      gradient.addColorStop(0, color);
      gradient.addColorStop(1, "transparent");
      ctx.fillStyle = gradient;
      ctx.fillRect(0, 0, 128, 128);

      const material = new THREE.SpriteMaterial({
        map: new THREE.CanvasTexture(canvas),
        transparent: true,
        opacity,
        depthTest: false,
      });
      const sprite = new THREE.Sprite(material);
      sprite.scale.set(size, size, 1);
      sprite.renderOrder = 10;
      return sprite;
    }

    function makeLabelSprite(primaryText: string, secondaryText: string, color = "#d7ff3a") {
      const canvas = document.createElement("canvas");
      const ctx = canvas.getContext("2d")!;
      const primarySize = 26;
      const secondarySize = 17;
      const gap = 6;

      ctx.font = `bold ${primarySize}px "JetBrains Mono", monospace`;
      const primaryWidth = ctx.measureText(primaryText).width;
      ctx.font = `${secondarySize}px "JetBrains Mono", monospace`;
      const secondaryWidth = ctx.measureText(secondaryText).width;

      canvas.width = Math.max(primaryWidth, secondaryWidth) + 32;
      canvas.height = primarySize + secondarySize + gap + 24;

      ctx.textBaseline = "top";
      ctx.fillStyle = color;
      ctx.font = `bold ${primarySize}px "JetBrains Mono", monospace`;
      ctx.fillText(primaryText, 16, 8);

      ctx.fillStyle = "#9aa0a6";
      ctx.font = `${secondarySize}px "JetBrains Mono", monospace`;
      ctx.fillText(secondaryText, 16, primarySize + gap + 8);

      const material = new THREE.SpriteMaterial({
        map: new THREE.CanvasTexture(canvas),
        transparent: true,
        depthTest: false,
        opacity: 0,
      });
      const sprite = new THREE.Sprite(material);
      const scale = 0.009;
      sprite.scale.set(canvas.width * scale, canvas.height * scale, 1);
      sprite.renderOrder = 10;
      return sprite;
    }

    function latLongToSurfacePoint(lat: number, lon: number, radius: number) {
      const phi = (90 - lat) * (Math.PI / 180);
      const theta = (lon + 180) * (Math.PI / 180);
      return new THREE.Vector3(
        -radius * Math.sin(phi) * Math.cos(theta),
        radius * Math.cos(phi),
        radius * Math.sin(phi) * Math.sin(theta)
      );
    }

    interface Marker {
      point: THREE.Vector3;
      dot: THREE.Sprite;
      halo: THREE.Sprite;
      label: THREE.Sprite;
      appearAt: number;
    }
    interface Connection {
      curve: THREE.CatmullRomCurve3;
      line: THREE.Line;
      packet: THREE.Sprite;
      appearAt: number;
    }

    const markers: Marker[] = [];
    let connection: Connection | null = null;

    function addMarkerAt(point: THREE.Vector3, ip: string, place: string, color: string, tag: string): Marker {
      const dot = makeGlowSprite(color, 0.22, 0);
      dot.position.copy(point);
      shell.add(dot);

      const halo = makeGlowSprite(color, 0.3, 0.6);
      halo.position.copy(point);
      shell.add(halo);

      const label = makeLabelSprite(ip, `${place} (${tag})`, color);
      label.position.copy(point.clone().multiplyScalar(1.35));
      shell.add(label);

      const marker: Marker = { point, dot, halo, label, appearAt: clock.getElapsedTime() };
      markers.push(marker);
      return marker;
    }

    // Dashed orbit arc between two antipodal points: rotates `a` 180 degrees around
    // a perpendicular axis, bulging the radius outward at the midpoint so the path
    // sweeps *around* the globe instead of a straight line through its center.
    function addOrbitConnection(a: THREE.Vector3, color: string) {
      const radius = a.length();
      const aHat = a.clone().normalize();
      const ref = Math.abs(aHat.y) > 0.95 ? new THREE.Vector3(1, 0, 0) : new THREE.Vector3(0, 1, 0);
      const perp = new THREE.Vector3().crossVectors(aHat, ref).normalize();
      const bulge = radius * 0.7;

      const segments = 64;
      const points: THREE.Vector3[] = [];
      for (let i = 0; i <= segments; i++) {
        const theta = (i / segments) * Math.PI;
        const dir = aHat.clone().multiplyScalar(Math.cos(theta)).add(
          new THREE.Vector3().crossVectors(perp, aHat).multiplyScalar(Math.sin(theta))
        );
        const r = radius + Math.sin(theta) * bulge;
        points.push(dir.multiplyScalar(r));
      }

      const curve = new THREE.CatmullRomCurve3(points);
      const geometry = new THREE.BufferGeometry().setFromPoints(points);
      const line = new THREE.Line(
        geometry,
        new THREE.LineDashedMaterial({ color, transparent: true, opacity: 0, dashSize: 0.12, gapSize: 0.1 })
      );
      line.computeLineDistances();
      line.renderOrder = 9;
      shell.add(line);

      const packet = makeGlowSprite(color, 0.14, 0);
      shell.add(packet);

      connection = { curve, line, packet, appearAt: clock.getElapsedTime() };
    }

    // Server marker (placeholder): Vercel edge IP, Washington D.C.
    const serverPoint = latLongToSurfacePoint(38.9072, -77.0369, 1.92);
    addMarkerAt(serverPoint, "76.76.21.164", "WASHINGTON, D.C.", "#ffffff", "SERVER");

    async function placeVisitorMarker() {
      try {
        const res = await fetch("https://ipapi.co/json/");
        if (!res.ok) throw new Error("geolocation unavailable");
        const data = await res.json();
        if (typeof data.latitude !== "number" || typeof data.longitude !== "number") return;

        const ipText = (data.ip || "UNKNOWN").toString();
        const place = [data.city, data.country_name].filter(Boolean).join(", ").toUpperCase() || "UNKNOWN LOCATION";

        // Placed at the exact antipode of the server marker so the two always sit
        // opposite each other on the globe, regardless of the visitor's real coordinates.
        const visitorPoint = serverPoint.clone().multiplyScalar(-1);
        addMarkerAt(visitorPoint, ipText, place, "#d7ff3a", "YOU");

        addOrbitConnection(serverPoint, "#d7ff3a");
      } catch {
        // Ad blockers / offline visitors just never get a marker -- fail silent.
      }
    }

    // Sparse debris field drifting around the core
    const debrisCount = 220;
    const debrisPositions = new Float32Array(debrisCount * 3);
    for (let i = 0; i < debrisCount; i++) {
      const radius = 3 + Math.random() * 3.5;
      const theta = Math.random() * Math.PI * 2;
      const phi = Math.acos(Math.random() * 2 - 1);
      debrisPositions[i * 3] = radius * Math.sin(phi) * Math.cos(theta);
      debrisPositions[i * 3 + 1] = radius * Math.sin(phi) * Math.sin(theta);
      debrisPositions[i * 3 + 2] = radius * Math.cos(phi);
    }
    const debrisGeometry = new THREE.BufferGeometry();
    debrisGeometry.setAttribute("position", new THREE.BufferAttribute(debrisPositions, 3));
    const debris = new THREE.Points(
      debrisGeometry,
      new THREE.PointsMaterial({ color: 0xffffff, size: 0.03, transparent: true, opacity: 0.5 })
    );
    rig.add(debris);

    function layoutRig() {
      // Sit in the empty right-hand side of the asymmetric text column on
      // wide viewports; stay centered (and smaller/dimmer) on narrow ones.
      const isWide = window.innerWidth >= 1024;
      rig.position.x = isWide ? 2.6 : 0;
      rig.scale.setScalar(isWide ? 1 : 0.7);
      // Hidden on small phones (the abstract shape would just fight the text there)
      rig.visible = window.innerWidth >= 640;
    }
    layoutRig();

    // Gentle cursor parallax -- the rig eases toward the pointer instead of
    // snapping straight to it.
    let targetX = 0;
    let targetY = 0;
    window.addEventListener(
      "pointermove",
      (e) => {
        targetX = (e.clientX / window.innerWidth) * 2 - 1;
        targetY = (e.clientY / window.innerHeight) * 2 - 1;
      },
      { passive: true }
    );

    function onResize() {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight, false);
      layoutRig();
    }
    window.addEventListener("resize", onResize);

    let running = true;
    document.addEventListener("visibilitychange", () => {
      running = document.visibilityState === "visible";
    });

    function animate() {
      requestAnimationFrame(animate);
      if (!running) return;

      const t = clock.getElapsedTime();

      shell.rotation.y = t * 0.12;
      shell.rotation.x = t * 0.05;
      core.rotation.y = -t * 0.2;
      core.rotation.x = -t * 0.08;
      debris.rotation.y = t * 0.03;

      rig.rotation.y += (targetX * 0.3 - rig.rotation.y) * 0.02;
      rig.rotation.x += (-targetY * 0.2 - rig.rotation.x) * 0.02;

      // Marker fade-in + radar-style expanding/fading "ping" ring per marker
      for (const marker of markers) {
        const age = t - marker.appearAt;
        (marker.dot.material as THREE.SpriteMaterial).opacity = Math.min(1, age / 0.6);
        (marker.label.material as THREE.SpriteMaterial).opacity = Math.min(0.9, age / 0.6);

        const cycle = age % 2;
        const scale = 0.22 + cycle * 0.35;
        marker.halo.scale.set(scale, scale, 1);
        (marker.halo.material as THREE.SpriteMaterial).opacity = Math.max(0, 0.6 - cycle * 0.3);
      }

      // Connection arc: fade in, then a packet glow travels back and forth along it
      if (connection) {
        const age = t - connection.appearAt;
        (connection.line.material as THREE.LineDashedMaterial).opacity = Math.min(0.45, (age / 0.8) * 0.45);

        const travel = (Math.sin(age * 0.6) + 1) / 2;
        connection.packet.position.copy(connection.curve.getPoint(travel));
        (connection.packet.material as THREE.SpriteMaterial).opacity = Math.min(0.9, age / 0.8);
      }

      renderer.render(scene, camera);
    }

    animate();
    placeVisitorMarker();
  }
</script>
