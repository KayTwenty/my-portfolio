---
import Skill from "./Skill.astro";
import { skillCategories } from "../data/skills";
---

<section id="skills" class="snap-start min-h-dvh w-full relative flex flex-col justify-center px-6 sm:px-12 lg:px-20 xl:px-28 py-24">
  <span class="section-index" aria-hidden="true" data-parallax="0.45">02</span>

  <div class="relative z-10 max-w-4xl">
    <p class="font-mono text-accent-dim text-xs sm:text-sm tracking-[0.3em] uppercase mb-4" data-reveal data-reveal-delay="0">// 02</p>
    <h2 class="glitch-text font-display text-3xl sm:text-4xl md:text-5xl font-bold text-white uppercase tracking-widest border-b-4 border-white/30 pb-2 sm:pb-3" data-text="Skills" data-reveal data-reveal-delay="80">Skills</h2>
    <p class="mt-5 sm:mt-7 text-lg sm:text-xl text-gray-300" data-reveal data-reveal-delay="160">
      I have been involved in this endeavor for nearly <span id="experience"></span> years,
      and it has been a journey filled with valuable lessons and personal growth.
    </p>

    <!-- Category Filter Tags -->
    <div class="mt-6 sm:mt-9 grid grid-cols-2 sm:flex sm:flex-wrap gap-2 sm:gap-3 font-mono" id="category-filters" data-reveal data-reveal-delay="240">
      <button
        data-category="all"
        class="category-tag active px-3 sm:px-4 py-2.5 sm:py-2 bg-accent text-black font-bold hover:bg-accent/80 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-accent uppercase tracking-wider text-center border-2 border-accent text-xs sm:text-sm min-h-11"
     >
        All
      </button>
      {
        skillCategories.map((category) => (
          <button
            data-category={category.category}
            class="category-tag px-3 sm:px-4 py-2.5 sm:py-2 bg-black border-2 border-white/40 text-gray-300 font-bold hover:bg-accent/10 hover:border-accent hover:text-accent transition focus:outline-none focus-visible:ring-2 focus-visible:ring-accent uppercase tracking-wider text-center text-xs sm:text-sm min-h-11"
          >
            {category.category}
          </button>
        ))
      }
    </div>

    <!-- Skills Grid -->
    <div class="mt-6 sm:mt-9 grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-2 sm:gap-3" id="skills-grid" data-reveal data-reveal-delay="320">
      {
        skillCategories.map((category) => (
          category.skills.map((skill) => (
            <div data-category={category.category}>
              <Skill title={skill.title} icon={skill.icon} link={skill.link} />
            </div>
          ))
        ))
      }
    </div>
  </div>
</section>

<script>
  import { getYearDiffFromDate } from "../utils/getYearDiffFromDate";

  const experience = document.getElementById("experience");
  experience!.innerText = getYearDiffFromDate("06/20/2019").toString();

  // Category filtering
  const categoryTags = document.querySelectorAll('.category-tag');
  const skillItems = document.querySelectorAll('#skills-grid > div');

  categoryTags.forEach(tag => {
    tag.addEventListener('click', () => {
      const selectedCategory = tag.getAttribute('data-category');
      
      // Update active state
      categoryTags.forEach(t => {
        t.classList.remove('active', 'bg-accent', 'text-black', 'border-accent');
        t.classList.add('bg-black', 'text-gray-300', 'border-white/40');
      });
      tag.classList.add('active', 'bg-accent', 'text-black', 'border-accent');
      tag.classList.remove('bg-black', 'text-gray-300', 'border-white/40');

      // Filter skills
      skillItems.forEach(item => {
        const htmlItem = item as HTMLElement;
        if (selectedCategory === 'all' || item.getAttribute('data-category') === selectedCategory) {
          htmlItem.style.display = 'block';
        } else {
          htmlItem.style.display = 'none';
        }
      });
    });
  });
</script>